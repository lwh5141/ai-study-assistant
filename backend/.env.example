# 运行环境：development / testing / production
FLASK_ENV=development

# Flask 自身安全密钥（不是 AI 的 Key！随便填一段乱码即可，生产环境再改）
SECRET_KEY=change-me-in-production

# 数据库（默认自动使用 backend/data.db，一般无需修改；如有需要取消注释）
# DATABASE_URL=sqlite:///F:/My_Project/AI_study_assistant/backend/data.db

# ---- 大模型 (LLM) — DeepSeek ----
# 这是调用 AI 的 Key，去 https://platform.deepseek.com/api_keys 获取
LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-chat
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key

# ---- 向量模型 (Embedding) — 阿里云百炼 ----
EMBEDDING_PROVIDER=bailian
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-bailian-api-key
EMBEDDING_SIMILARITY_THRESHOLD=0.3

# ---- RAG 参数 ----
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_DEFAULT=5

# ---- 混合检索参数（v0.3.0 新增） ----
# RETRIEVAL_MODE=hybrid         # dense（纯向量）| hybrid（向量+关键词，默认）
# DENSE_CANDIDATES=10            # 向量召回候选数（默认 10）
# BM25_CANDIDATES=10             # 关键词召回候选数（默认 10）
# RRF_K=60                       # RRF 融合平滑参数（默认 60，标准值）

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=backend/chroma_data
