# ============================================================
#  AI Study Assistant — 环境变量配置模板
#  复制此文件为 .env 并填入你的配置
#  警告：.env 已在 .gitignore 中排除，切勿将真实 Key 提交到 Git
# ============================================================

# -------- 运行环境 --------
FLASK_ENV=development                       # development | testing | production
SECRET_KEY=change-me-in-production          # Flask 安全密钥（非 AI Key，随便填）

# -------- LLM 大模型（对话 / 出题 / 批改 / 周报）--------
# 提供商：DeepSeek    获取 Key：https://platform.deepseek.com/api_keys
LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-chat
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key            # ← 必填

# -------- Embedding 向量模型（文档向量化与语义检索）--------
# 提供商：阿里云百炼  获取 Key：https://bailian.console.aliyun.com/
EMBEDDING_PROVIDER=bailian
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-bailian-api-key   # ← 必填
EMBEDDING_SIMILARITY_THRESHOLD=0.3

# -------- RAG 分块与检索参数 --------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_DEFAULT=5

# -------- 混合检索（v0.3.0+，默认即为最优，一般无需修改）--------
# RETRIEVAL_MODE=hybrid          # dense（纯向量）| hybrid（BM25+向量，默认）
# DENSE_CANDIDATES=10            # 向量路候选数
# BM25_CANDIDATES=10             # 关键词路候选数
# RRF_K=60                       # RRF 融合平滑参数

# -------- ChromaDB（内置嵌入式向量库，无需额外部署服务）--------
CHROMA_PERSIST_DIR=backend/chroma_data

# ============================================================
#  更多配置与说明参见 README.md → 配置说明
# ============================================================
